                                    "bearer": [
                                        {
                                            "key": "token",
                                            "value": "{{admin_token}}",
                                            "type": "string"
                                        }
                                    ]
                                },
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"order_id\": 1,\n    \"amount\": 2000\n}"
                                },
                                "url": "{{base_url}}/admin/payments",
                                "description": "Records a manual cash payment. `amount` in **cents**. 422 if the amount exceeds the order's outstanding balance. Payments are immutable — no edit/refund/delete/fail endpoints (ADR 0002)."
                            }
                        }
                    ]
                },
